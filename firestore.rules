rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return signedIn() && userDoc().exists()
          ? userDoc().data.role
          : 'student';
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isCounselor() {
      return userRole() == 'counselor';
    }

    function isPeerBuddy() {
      return userRole() == 'peer_buddy';
    }

    function isReportOwnerData(data) {
      return signedIn() && (
        (data.userId != null && data.userId == request.auth.uid) ||
        (data.createdByUid != null && data.createdByUid == request.auth.uid)
      );
    }

    function isAssignedCounselorData(data) {
      return signedIn() && isCounselor() && (
        (data.assignedCounselorUid != null && data.assignedCounselorUid == request.auth.uid) ||
        (data.counselorUid != null && data.counselorUid == request.auth.uid)
      );
    }

    function isConversationParticipantData(data) {
      return signedIn() && (
        (data.participants != null && request.auth.uid in data.participants) ||
        (data.user1Id != null && data.user1Id == request.auth.uid) ||
        (data.user2Id != null && data.user2Id == request.auth.uid)
      );
    }

    function isBuddyMatchParticipantData(data) {
      return signedIn() && (
        (data.user1Id != null && data.user1Id == request.auth.uid) ||
        (data.user2Id != null && data.user2Id == request.auth.uid)
      );
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && (
        isSelf(uid) || isAdmin()
      );

      allow update: if signedIn() && (
        isAdmin() ||
        (isSelf(uid) && request.resource.data.role == resource.data.role)
      );

      allow delete: if isAdmin();

      match /buddies/{buddyId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      match /conversations/{conversationId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      match /quiz_responses/{responseId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      match /progress/{progressId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      match /meetups/{meetupId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && isReportOwnerData(request.resource.data);

      allow read: if signedIn() && (
        isAdmin() ||
        isReportOwnerData(resource.data) ||
        isAssignedCounselorData(resource.data)
      );

      allow update: if signedIn() && (
        isAdmin() ||
        isAssignedCounselorData(resource.data) ||
        isReportOwnerData(resource.data)
      );

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn() && (
          isAdmin() ||
          isReportOwnerData(get(/databases/$(database)/documents/reports/$(reportId)).data) ||
          isAssignedCounselorData(get(/databases/$(database)/documents/reports/$(reportId)).data)
        );

        allow create: if signedIn() && (
          isAdmin() ||
          isReportOwnerData(get(/databases/$(database)/documents/reports/$(reportId)).data) ||
          isAssignedCounselorData(get(/databases/$(database)/documents/reports/$(reportId)).data)
        );

        allow update, delete: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow create: if signedIn() && (
        (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.studentUid != null && request.resource.data.studentUid == request.auth.uid)
      );

      allow read: if signedIn() && (
        isAdmin() ||
        isCounselor() ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid)
      );

      allow update: if signedIn() && (
        isAdmin() ||
        isCounselor() ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid)
      );

      allow delete: if isAdmin();
    }

    match /buddy_matches/{matchId} {
      allow create: if signedIn() && (
        request.resource.data.user1Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid
      );

      allow read, update: if isAdmin() || isBuddyMatchParticipantData(resource.data);
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow create: if signedIn() && isConversationParticipantData(request.resource.data);
      allow read, update: if isAdmin() || isConversationParticipantData(resource.data);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isConversationParticipantData(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        );

        allow create: if signedIn() && (
          isAdmin() ||
          isConversationParticipantData(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
        );

        allow update, delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid)
      );

      allow create: if signedIn() && (
        isAdmin() ||
        (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid)
      );

      allow update, delete: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        isAdmin() ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.authorId != null && resource.data.authorId == request.auth.uid) ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid)
      );

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn() && (
          isAdmin() ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (resource.data.authorId != null && resource.data.authorId == request.auth.uid)
        );
      }

      match /reports/{reportId} {
        allow read, create: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /meetups/{meetupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        isAdmin() ||
        (resource.data.createdBy != null && resource.data.createdBy == request.auth.uid) ||
        (resource.data.hostId != null && resource.data.hostId == request.auth.uid)
      );
    }

    match /counselors/{counselorId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /badges/{badgeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /campus_zones/{zoneId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sos_alerts/{alertId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (resource.data.userId != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /emergency_alerts/{alertId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (resource.data.userId != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
